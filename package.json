{
  "name": "monitor-theme-lumina",
  "private": true,
  "version": "0.0.3",
  "type": "module",
  "description": "monitor 的状态页主题，移植自 Komari 的 Lumina",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
