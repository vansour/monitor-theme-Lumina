    "package": "tar czf theme.tar.gz dist theme.json preview.png",
    "changelog": "node scripts/changelog.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@tanstack/react-query": "^5.80.7",
    "clsx": "^2.1.1",
    "lucide-react": "^1.49.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.5",
    "uplot": "^1.6.32",
    "uplot-react": "^1.2.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@types/node": "^26.6.3",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
