{
  "name": "Lumina",
  "short": "lumina",
  "description": "Lumina by vansour",
  "version": "0.0.5",
  "author": "vansour",
  "url": "https://github.com/vansour/monitor-theme-Lumina",
  "config": [
    { "type": "title", "label": "外观" },
    {
      "key": "default_appearance",
      "type": "select",
      "default": "system",
      "label": "默认外观",
      "help": "访客自己切换过之后，跟随访客的选择",
      "options": [
        { "value": "system", "label": "跟随系统" },
        { "value": "light", "label": "浅色" },
        { "value": "dark", "label": "深色" }
      ]
    },
    {
      "key": "enable_admin_button",
      "type": "boolean",
      "default": true,
      "label": "显示后台入口",
      "help": "右上角设置菜单里的一行，指向 /admin/"
    },

    { "type": "title", "label": "首页" },
    {
      "key": "show_overview",
      "type": "boolean",
      "default": true,
      "label": "显示首页总览",
      "help": "卡片列表上方的一行小格子：在线节点数、实时带宽合计、CPU / 内存 / 磁盘占用与本月流量。数据全部来自已有的实时推送，不额外请求 hub"
    },
    {
      "key": "group_nodes",
      "type": "boolean",
      "default": true,
      "label": "首页按分组分区",
      "help": "卡片按 hub 后台设的分组分区显示，标题可以收起一组，上面的标签栏可以只看某一组。没分组的节点单独成区、排在最后。关掉就回到不分组的平铺栅格"
    },
    {
      "key": "offline_nodes_behind",
      "type": "boolean",
      "default": false,
      "label": "离线节点排在最后",
      "help": "不改变站长在后台拖出来的相对顺序，只把离线的整体移到后面"
    },

    { "type": "title", "label": "详情页" },
    {
      "key": "show_ping_chart",
      "type": "boolean",
      "default": true,
      "label": "显示网络延迟页签"
    },
    {
      "key": "default_range_hours",
      "type": "select",
      "default": "6",
      "label": "默认时间范围",
      "help": "打开详情页时先画的范围。未登录访客最多 168 小时，登录后 2160 小时。",
      "options": [
        { "value": "1", "label": "1 小时" },
        { "value": "6", "label": "6 小时" },
        { "value": "24", "label": "24 小时" },
        { "value": "168", "label": "7 天" }
      ]
    }
  ]
}
